@dataclass
class TextFeatures:
    sentiment:   float   # -1.0 to +1.0
    arousal:     float   # 0.0 to 1.0 (intensity of emotion, regardless of sign)
    certainty:   float   # 0.0 to 1.0 (linguistic confidence)
    raw_scores:  dict

class SentimentEngine:

    # Linguistic markers for certainty detection (no model needed)
    UNCERTAINTY_MARKERS = [
        "maybe", "perhaps", "i think", "i guess", "i'm not sure",
        "not sure", "kind of", "sort of", "might", "probably",
        "i don't know", "idk", "possibly", "could be", "not really"
    ]
    CERTAINTY_MARKERS = [
        "definitely", "absolutely", "i know", "clearly", "obviously",
        "for sure", "certainly", "without doubt", "i'm certain", "100%"
    ]

    # High-arousal words — language that signals intensity
    HIGH_AROUSAL_WORDS = [
        "hate", "love", "terrified", "ecstatic", "furious", "desperate",
        "amazing", "awful", "incredible", "horrible", "fantastic", "terrible",
        "overwhelmed", "devastated", "thrilled", "panic", "crash", "emergency"
    ]

    def __init__(self, use_transformer: bool = True):
        self.use_transformer = use_transformer
        self._model     = None
        self._tokenizer = None

        if use_transformer:
            try:
                self._load_transformer()
            except Exception as e:
                print(f"[SentimentEngine] Transformer unavailable: {e}")
                print("[SentimentEngine] Falling back to lexical analysis.")
                self.use_transformer = False

    def _load_transformer(self):
        from transformers import pipeline
        # distilbert — tiny, fast, runs on CPU
        self._pipe = pipeline(
            "sentiment-analysis",
            model="distilbert-base-uncased-finetuned-sst-2-english",
            device=-1   # CPU
        )
        print("[SentimentEngine] Transformer loaded: distilbert-sst2")

    def _lexical_sentiment(self, text: str) -> float:
        """Fallback lexical scorer — no model required."""
        negative = ["hate","awful","terrible","horrible","bad","sad","angry",
                    "scared","afraid","worried","hurt","pain","fail","broken",
                    "tired","exhausted","depressed","anxious","panic","cry"]
        positive = ["good","great","happy","love","amazing","wonderful","excited",
                    "glad","joy","fun","awesome","fantastic","thank","grateful",
                    "proud","hope","better","success","win","yes"]
        tl = text.lower()
        pos = sum(1 for w in positive if w in tl)
        neg = sum(1 for w in negative if w in tl)
        total = pos + neg
        if total == 0:
            return 0.0
        return (pos - neg) / total

    def _compute_arousal(self, text: str) -> float:
        tl = text.lower()
        base_arousal = sum(1 for w in self.HIGH_AROUSAL_WORDS if w in tl)
        # Punctuation intensity
        exclamations = text.count('!')
        caps_ratio   = sum(1 for c in text if c.isupper()) / max(len(text), 1)
        # Sentence length variance — choppy sentences = high arousal
        sentences    = re.split(r'[.!?]+', text)
        lengths      = [len(s.split()) for s in sentences if s.strip()]
        length_var   = (max(lengths) - min(lengths)) / max(max(lengths), 1) if lengths else 0

        arousal = clamp(
            base_arousal * 0.15
            + exclamations * 0.08
            + caps_ratio   * 0.30
            + length_var   * 0.20
            + min(len(text) / 500.0, 0.30),   # long messages = more arousal
            0.0, 1.0
        )
        return arousal

    def _compute_certainty(self, text: str) -> float:
        tl = text.lower()
        uncertainty_hits = sum(1 for m in self.UNCERTAINTY_MARKERS if m in tl)
        certainty_hits   = sum(1 for m in self.CERTAINTY_MARKERS   if m in tl)
        # Question marks reduce certainty
        questions = text.count('?')
        # Hedging phrases
        raw = (certainty_hits - uncertainty_hits * 1.5 - questions * 0.3)
        return clamp(0.5 + raw * 0.15, 0.0, 1.0)

    def analyze(self, text: str) -> TextFeatures:
        if not text or not text.strip():
            return TextFeatures(0.0, 0.0, 0.5, {})

        # Sentiment score
        if self.use_transformer:
            result = self._pipe(text[:512])[0]  # truncate to model limit
            label, score = result["label"], result["score"]
            sentiment = (score if label == "POSITIVE" else -score)
        else:
            sentiment = self._lexical_sentiment(text)

        arousal   = self._compute_arousal(text)
        certainty = self._compute_certainty(text)

        return TextFeatures(
            sentiment = clamp(sentiment, -1.0, 1.0),
            arousal   = arousal,
            certainty = certainty,
            raw_scores = {
                "transformer_used": self.use_transformer,
                "word_count":       len(text.split()),
                "char_count":       len(text)
            }
        )


class TypingAnalyzer:
    """
    Analyzes typing metadata streamed from a frontend.
    In Colab: you simulate this. In production: JS sends keystroke timestamps.
    """

    def __init__(self, baseline_cpm: float = 280.0):
        self.baseline_cpm   = baseline_cpm
        self._keystroke_buf = []   # list of (timestamp_ms, char) tuples
        self._backspaces    = 0
        self._total_chars   = 0

    def record_keystroke(self, timestamp_ms: float, char: str):
        self._keystroke_buf.append((timestamp_ms, char))
        if char == '\x08' or char == 'BACKSPACE':
            self._backspaces += 1
        self._total_chars += 1

    def compute_features(self) -> dict:
        if len(self._keystroke_buf) < 2:
            return {
                "speed_cpm":     self.baseline_cpm,
                "pause_ratio":   0.1,
                "backspace_rate": 0.0
            }

        timestamps = [t for t, _ in self._keystroke_buf]
        intervals  = [timestamps[i+1] - timestamps[i]
                      for i in range(len(timestamps)-1)]

        # Typing speed
        total_time_min = (timestamps[-1] - timestamps[0]) / 60000.0
        speed_cpm = self._total_chars / max(total_time_min, 0.001)

        # Pause ratio: intervals > 2s count as pauses
        PAUSE_THRESHOLD_MS = 2000
        pause_time  = sum(iv for iv in intervals if iv > PAUSE_THRESHOLD_MS)
        total_time  = timestamps[-1] - timestamps[0]
        pause_ratio = pause_time / max(total_time, 1)

        # Backspace rate per 100 chars
        backspace_rate = (self._backspaces / max(self._total_chars, 1)) * 100.0

        # Reset buffer
        self._keystroke_buf = []
        self._backspaces    = 0
        self._total_chars   = 0

        return {
            "speed_cpm":      clamp(speed_cpm,     0, 800),
            "pause_ratio":    clamp(pause_ratio,    0, 1.0),
            "backspace_rate": clamp(backspace_rate, 0, 50)
        }


def clamp(v, lo, hi):
    return max(lo, min(hi, v))

