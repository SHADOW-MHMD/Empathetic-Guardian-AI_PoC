    def __init__(self):
        self.sentiment_engine = SentimentEngine(use_transformer=True)
        self.typing_analyzer  = TypingAnalyzer(baseline_cpm=280)
        self.memory           = MemorySystem()

        self.body   = VirtualBodyV2()
        self.social = SocialEmotionalState()
        self.tick   = 0
        self.warmth_accumulator = 0.0

        self._trust_history    = []
        self._cortisol_history = []
        self._warmth_history   = []

        self._load_or_init()

    def _load_or_init(self):
        """Load persisted state or boot fresh."""
        warmth_acc = ctypes.c_float(0.0)
        ticks      = ctypes.c_uint32(0)

        result = lib.load_state(
            self.PERSIST_PATH.encode(),
            ctypes.byref(self.body),
            ctypes.byref(self.social),
            ctypes.byref(warmth_acc),
            ctypes.byref(ticks)
        )

        if result == 0:
            self.warmth_accumulator = warmth_acc.value
            self.tick               = ticks.value
            print(f"[Guardian] Restored: tick={self.tick}, "
                  f"trust={self.social.trust_level:.2f}, "
                  f"bond={self.social.bond_strength:.2f}, "
                  f"phase={self.social.phase}")

            # Pull emotional memory and apply to social state
            memory = self.memory.compute_emotional_memory()
            self.social.joy_reservoir   = memory.joy_reservoir
            self.social.trauma_residue  = memory.trauma_residue
            print(f"[Guardian] Memory: joy={memory.joy_reservoir:.2f}, "
                  f"trauma={memory.trauma_residue:.2f}, "
                  f"historical_dominant={memory.dominant_historical_state}")
        else:
            lib.init_social_state(ctypes.byref(self.social))
            self.body.virtual_serotonin = 0.65
            self.body.virtual_dopamine  = 0.50
            self.body._noise_seed       = int(time.time()) & 0xFFFFFFFF
            print("[Guardian] Fresh start — no previous state found.")

    def process_message(self,
                         user_text: str,
                         biometrics: dict = None,
                         voice_features: dict = None,
                         typing_metadata: list = None) -> dict:
        """
        Full pipeline for one message.
        Returns a dict with felt experience + response guidance.
        """

        # ── 1. Text analysis ──
        text_feat = self.sentiment_engine.analyze(user_text)

        # ── 2. Typing analysis ──
        if typing_metadata:
            for ts, ch in typing_metadata:
                self.typing_analyzer.record_keystroke(ts, ch)
        typing_feat = self.typing_analyzer.compute_features()

        # ── 3. Build SensorInputV2 ──
        sensor = SensorInputV2()

        # Biometrics — use provided or simulate neutral
        bio = biometrics or {}
        sensor.heart_rate_bpm  = bio.get("hr",     72.0)
        sensor.systolic_bp     = bio.get("sbp",   118.0)
        sensor.diastolic_bp    = bio.get("dbp",    76.0)
        sensor.hrv_rmssd_ms    = bio.get("hrv",    48.0)
        sensor.sensor_confidence = bio.get("confidence", 0.85)

        # Voice
        vf = voice_features or {}
        sensor.voice_pitch_hz   = vf.get("pitch",   175.0)
        sensor.voice_energy_db  = vf.get("energy",  -30.0)
        sensor.voice_tempo_wpm  = vf.get("tempo",   130.0)
        sensor.voice_tremor     = vf.get("tremor",    0.05)
        sensor.voice_valence    = vf.get("valence",   0.10)

        # Text features
        sensor.text_sentiment  = text_feat.sentiment
        sensor.text_arousal    = text_feat.arousal
        sensor.text_certainty  = text_feat.certainty

        # Typing features
        sensor.typing_speed_cpm     = typing_feat["speed_cpm"]
        sensor.typing_pause_ratio   = typing_feat["pause_ratio"]
        sensor.backspace_rate       = typing_feat["backspace_rate"]

        # Baselines
        sensor.baseline_hr     = 68.0
        sensor.baseline_hrv    = 52.0
        sensor.baseline_pitch  = 175.0
        sensor.baseline_tempo  = 130.0
        sensor.baseline_typing_speed = 280.0

        # ── 4. Run C engine ──
        lib.fuse_sensors_v2(ctypes.byref(sensor),
                             ctypes.byref(self.body),
                             ctypes.byref(self.social))
        lib.compute_felt_v2(ctypes.byref(self.body),
                             ctypes.byref(self.social))
        lib.apply_homeostasis_v2(ctypes.byref(self.body),
                                  ctypes.byref(self.social),
                                  ctypes.c_float(1.0))

        # ── 5. Update social state ──
        interaction_quality = clamp(
            text_feat.sentiment * 0.5
            + (1.0 - sensor.voice_tremor) * 0.3
            + (self.body.felt_warmth - 0.5) * 0.4,
            -1.0, 1.0
        )
        lib.update_trust(ctypes.byref(self.social),
                          ctypes.byref(self.body),
                          ctypes.c_float(interaction_quality),
                          ctypes.c_float(1.0))
        lib.update_bonding(ctypes.byref(self.social),
                            ctypes.c_float(1.0),
                            ctypes.c_float(self.body.felt_warmth))

        # ── 6. Interpret felt experience ──
        exp = FeltExperienceV2()
        lib.interpret_experience_v2(ctypes.byref(self.body),
                                     ctypes.byref(self.social),
                                     ctypes.byref(exp))

        # ── 7. Build output dicts ──
        body_snap = {f: getattr(self.body, f) for f, _ in VirtualBodyV2._fields_
                     if not f.startswith("_")}
        exp_snap = {
            "primary":       exp.primary_feeling.decode(),
            "secondary":     exp.secondary_feeling.decode(),
            "intensity":     exp.intensity,
            "empathy":       exp.empathy_signal,
            "cognitive":     exp.cognitive_color.decode(),
            "guidance":      exp.response_guidance.decode(),
            "relationship":  exp.relationship_note.decode(),
            "phase":         exp.relationship_phase,
            "phase_name":    ["STRANGER","ACQUAINTANCE","FAMILIAR",
                              "TRUSTED","BONDED","DEEP_BOND"][exp.relationship_phase]
        }

        # ── 8. Record to memory ──
        self.memory.record_interaction(
            body_snap, exp_snap, self.tick,
            interaction_quality, user_text
        )

        # ── 9. Track histories for session close ──
        self._trust_history.append(self.social.trust_level)
        self._cortisol_history.append(self.body.virtual_cortisol)
        self._warmth_history.append(self.body.felt_warmth)
        self.warmth_accumulator += self.body.felt_warmth
        self.tick += 1

        return {"body": body_snap, "experience": exp_snap,
                "text_features": {
                    "sentiment": text_feat.sentiment,
                    "arousal":   text_feat.arousal,
                    "certainty": text_feat.certainty
                }}

    def save(self):
        """Persist state to disk."""
        lib.save_state(
            self.PERSIST_PATH.encode(),
            ctypes.byref(self.body),
            ctypes.byref(self.social),
            ctypes.c_float(self.warmth_accumulator),
            ctypes.c_uint32(self.tick)
        )
        avg_trust    = sum(self._trust_history)    / max(len(self._trust_history),    1)
        avg_cortisol = sum(self._cortisol_history) / max(len(self._cortisol_history), 1)
        avg_warmth   = sum(self._warmth_history)   / max(len(self._warmth_history),   1)

        self.memory.close_session(
            avg_trust, avg_cortisol, avg_warmth,
            "UNKNOWN", self.social.phase
        )
        print(f"[Guardian] State saved. Tick={self.tick}, "
              f"Phase={self.social.phase}, Trust={self.social.trust_level:.3f}")

    def get_llm_system_prompt(self) -> str:
        """
        Build the felt-state system prompt for LLM injection.
        This runs after process_message() has updated the body.
        """
        s = self.body
